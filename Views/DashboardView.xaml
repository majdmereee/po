<Window x:Class="RestaurantHR_App.Views.DashboardView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="نظام الموارد البشرية 2026" Height="750" Width="1200"
        FlowDirection="RightToLeft" WindowStartupLocation="CenterScreen" 
        Background="#0F172A" Foreground="#F8FAFC">

    <Window.Resources>
        <Style x:Key="PillBtn" TargetType="Button">
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="سجل الحضور والغياب للمطعم" FontSize="24" FontWeight="Bold"/>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <TextBlock Text="الحاضرون اليوم: " Foreground="#94A3B8"/>
                    <TextBlock Text="{Binding PresentToday}" Foreground="#10B981" FontWeight="Bold"/>
                    <TextBlock Text=" / " Foreground="#94A3B8"/>
                    <TextBlock Text="{Binding TotalEmployees}" Foreground="#94A3B8" FontWeight="Bold"/>
                </StackPanel>
            </StackPanel>
            <Button Content="+ تسجيل حضور يدوي" Click="OpenAddAttendance_Click" Style="{StaticResource PillBtn}" Background="#2563EB" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
        </DockPanel>

        <Border Grid.Row="1" Background="#1E293B" CornerRadius="12" Padding="15" Margin="0,0,0,20">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="بحث:" VerticalAlignment="Center" Foreground="#94A3B8" Margin="0,0,10,0"/>
                    <TextBox x:Name="TxtSearch" Width="200" Height="36" Padding="10,8" 
                             Background="#0F172A" Foreground="White" BorderBrush="#334155" 
                             BorderThickness="1" TextChanged="Filter_Changed" />
                    
                    <TextBlock Text="الفترة:" VerticalAlignment="Center" Foreground="#94A3B8" Margin="20,0,10,0"/>
                    <ComboBox x:Name="CmbDateFilter" Width="130" Height="36" SelectionChanged="Filter_Changed" SelectedIndex="0">
                        <ComboBoxItem Content="اليوم"/>
                        <ComboBoxItem Content="آخر 7 أيام"/>
                        <ComboBoxItem Content="آخر 30 يوم"/>
                        <ComboBoxItem Content="فترة مخصصة"/>
                    </ComboBox>

                    <DatePicker x:Name="DpStart" Width="120" Height="36" Margin="10,0,0,0" SelectedDateChanged="Filter_Changed"/>
                    <DatePicker x:Name="DpEnd" Width="120" Height="36" Margin="5,0,0,0" SelectedDateChanged="Filter_Changed"/>
                </StackPanel>
                <Button Content="📥 تصدير Excel" Click="ExportExcel_Click" Style="{StaticResource PillBtn}" Background="#10B981" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Background="#1E293B" CornerRadius="12" Padding="10">
            <DataGrid ItemsSource="{Binding FilteredAttendances}" AutoGenerateColumns="False" 
                      CanUserAddRows="False" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155"
                      RowHeight="42" Background="Transparent" BorderThickness="0" Foreground="#F8FAFC">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#1E293B"/>
                        <Setter Property="Foreground" Value="#94A3B8"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Height" Value="35"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#334155"/>
                    </Style>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#334155"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat=yyyy-MM-dd}" Width="120"/>
                    <DataGridTextColumn Header="الموظف" Binding="{Binding Employee.Name}" Width="*"/>
                    <DataGridTextColumn Header="الدخول" Binding="{Binding CheckInTime, StringFormat=\{0:hh\\\\:mm\}}" Width="120"/>
                    <DataGridTextColumn Header="الخروج" Binding="{Binding CheckOutTime, StringFormat=\{0:hh\\\\:mm\}}" Width="120"/>
                    <DataGridTextColumn Header="إضافي" Binding="{Binding OvertimeHours}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>
