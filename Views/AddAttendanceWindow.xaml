<Window x:Class="RestaurantHR_App.Views.AddAttendanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تسجيل حضور جديد" Height="450" Width="400"
        WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft"
        Background="#0F172A" Foreground="#F8FAFC" WindowStyle="ToolWindow">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="إضافة سجل دوام" FontSize="18" FontWeight="Bold" Margin="0,0,0,20" Grid.Row="0"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="اختر الموظف:" Foreground="#94A3B8" Margin="0,0,0,5"/>
            <ComboBox x:Name="CmbEmployees" DisplayMemberPath="Name" SelectedValuePath="Id" Height="35" FontSize="14"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,15">
            <TextBlock Text="تاريخ الدوام:" Foreground="#94A3B8" Margin="0,0,0,5"/>
            <DatePicker x:Name="DpDate" Height="35" FontSize="14"/>
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                <TextBlock Text="وقت الدخول (HH:MM):" Foreground="#94A3B8" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtCheckIn" Text="09:00" Height="35" Padding="5" FontSize="14"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                <TextBlock Text="وقت الخروج (HH:MM):" Foreground="#94A3B8" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtCheckOut" Text="17:00" Height="35" Padding="5" FontSize="14"/>
            </StackPanel>
        </Grid>

        <Button Grid.Row="4" Content="حفظ البيانات" Click="Save_Click" Height="40" FontSize="15" FontWeight="Bold"
                Background="#10B981" Foreground="White" BorderThickness="0" Cursor="Hand" VerticalAlignment="Bottom"/>
    </Grid>
</Window>
